<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="screen_pad">12dp</dimen>
    <dimen name="gap">10dp</dimen>
    <dimen name="gap_small">6dp</dimen>
    <!-- Space between the seek band and the pad row: 1.5x the normal gap, so a
         thumb that misses the slider lands on nothing instead of the pads. -->
    <dimen name="seek_gap">15dp</dimen>
    <dimen name="corner">14dp</dimen>
    <dimen name="corner_small">9dp</dimen>

    <!-- Touch targets. Everything interactive is at least 48dp tall,
         primary controls are 56-72dp. -->
    <dimen name="touch">48dp</dimen>
    <dimen name="row_min_height">64dp</dimen>
    <!-- Exact height of every All-files row in discrete mode. It is expressed
         in sp so it grows with the user's font size: a fixed 64 dp box used to
         cut the size / saved-position line in half on phones with large text.
         At the default font scale this is still 64 dp. -->
    <dimen name="row_discrete_height">64sp</dimen>
    <dimen name="folder_delimiter_height">40dp</dimen>
    <dimen name="play_button_width">88dp</dimen>
    <dimen name="tab_height">54dp</dimen>
    <dimen name="step_height">52dp</dimen>
    <dimen name="transport_height">68dp</dimen>
    <dimen name="seek_height">48dp</dimen>
    <dimen name="button_min_width">120dp</dimen>
</resources>
