<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/permission_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/permission_title" />

                <TextView
                    android:id="@+id/permission_body"
                    style="@style/SettingSummary"
                    android:layout_marginTop="10dp"
                    android:text="@string/permission_body" />

                <TextView
                    android:id="@+id/permission_app_folder_hint"
                    style="@style/SettingSummary"
                    android:layout_marginTop="14dp" />

                <Button
                    android:id="@+id/permission_grant"
                    style="@style/PrimaryActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/step_height"
                    android:layout_marginTop="18dp"
                    android:text="@string/permission_grant" />

                <Button
                    android:id="@+id/permission_app_folder"
                    style="@style/SettingActionButton"
                    android:text="@string/permission_app_folder" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
