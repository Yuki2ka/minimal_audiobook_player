<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed player panel. Top to bottom:
       played / total / remaining times
       precise seek bar (tap anywhere to jump)
       proportional seek pads around a big icon-only play button
       previous, -N s, +N s, next
     The file name is not repeated here: the playing file is pinned to the top
     of the list, which leaves more room for the controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/time_position"
            style="@style/PlayerTime"
            android:text="0:00" />

        <TextView
            android:id="@+id/time_total"
            style="@style/PlayerTime"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0:00" />

        <TextView
            android:id="@+id/time_remaining"
            style="@style/PlayerTime"
            android:gravity="end"
            android:text="0:00" />
    </LinearLayout>

    <!-- Precise seek bar: tap anywhere on the bar to jump there. -->
    <SeekBar
        android:id="@+id/seek_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/seek_bar"
        android:max="1000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:progress="0"
        android:progressDrawable="@drawable/seek_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seek_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <io.github.yuki2ka.audiobookplayer.ui.SeekPad
            android:id="@+id/pad_back"
            android:layout_width="0dp"
            android:layout_height="@dimen/transport_height"
            android:layout_weight="1" />

        <Space
            android:layout_width="@dimen/gap"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_play"
            style="@style/PrimaryIconButton"
            android:layout_width="88dp"
            android:layout_height="@dimen/transport_height"
            android:contentDescription="@string/play"
            android:src="@drawable/ic_play_state" />

        <Space
            android:layout_width="@dimen/gap"
            android:layout_height="1dp" />

        <io.github.yuki2ka.audiobookplayer.ui.SeekPad
            android:id="@+id/pad_forward"
            android:layout_width="0dp"
            android:layout_height="@dimen/transport_height"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_prev"
            style="@style/TransportButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/prev_file"
            android:drawableTop="@drawable/ic_skip_prev"
            android:text="@string/prev_short" />

        <Space
            android:layout_width="@dimen/gap_small"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_back"
            style="@style/StepChipButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/seek_back_default" />

        <Space
            android:layout_width="@dimen/gap_small"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_forward"
            style="@style/StepChipButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/seek_forward_default" />

        <Space
            android:layout_width="@dimen/gap_small"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_next"
            style="@style/TransportButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/next_file"
            android:drawableTop="@drawable/ic_skip_next"
            android:text="@string/next_short" />
    </LinearLayout>
</LinearLayout>
