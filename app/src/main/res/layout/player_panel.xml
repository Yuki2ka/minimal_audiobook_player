<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed player panel: current file, rough progress, precise seek bar,
     +- step buttons and the three transport buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/player_title"
        style="@style/PlayerTitle"
        android:text="@string/nothing_playing" />

    <TextView
        android:id="@+id/player_subtitle"
        style="@style/PlayerMeta"
        android:layout_marginTop="2dp"
        android:text="@string/nothing_playing_hint" />

    <!-- Rough overall position (thin bar, 0..1000) -->
    <ProgressBar
        android:id="@+id/rough"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/rough_progress"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/rough_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/time_position"
            style="@style/PlayerTime"
            android:text="0:00" />

        <TextView
            android:id="@+id/progress_percent"
            style="@style/PlayerTime"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 %" />

        <TextView
            android:id="@+id/time_remaining"
            style="@style/PlayerTime"
            android:text="0:00" />
    </LinearLayout>

    <!-- Precise seek bar: tap anywhere on the bar to jump there. -->
    <SeekBar
        android:id="@+id/seek_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/seek_height"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/seek_bar"
        android:max="1000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:progress="0"
        android:progressDrawable="@drawable/seek_progress"
        android:splitTrack="false"
        android:thumb="@drawable/seek_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_back"
            style="@style/StepButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nothing_playing" />

        <Space
            android:layout_width="@dimen/gap"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_forward"
            style="@style/StepButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nothing_playing" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_prev"
            style="@style/TransportButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/prev_file"
            android:drawableTop="@drawable/ic_skip_prev"
            android:text="@string/prev_short" />

        <Space
            android:layout_width="@dimen/gap"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_play"
            style="@style/PrimaryTransportButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/play"
            android:drawableTop="@drawable/ic_play_state"
            android:text="@string/play" />

        <Space
            android:layout_width="@dimen/gap"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_next"
            style="@style/TransportButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/next_file"
            android:drawableTop="@drawable/ic_skip_next"
            android:text="@string/next_short" />
    </LinearLayout>
</LinearLayout>
