<?xml version="1.0" encoding="utf-8"?>
<!-- Names a contiguous folder group in the flat list. The line to the right
     makes this a delimiter rather than another navigable folder row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/folder_delimiter_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="18dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder"
        android:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/folder_delimiter_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxWidth="260dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@color/divider"
        android:importantForAccessibility="no" />
</LinearLayout>
