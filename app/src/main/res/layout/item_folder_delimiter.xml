<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the folder tree in the flat list. A folder gets two of these:

       * opening: the folder icon, the folder name and a rule to the right;
       * closing: no icon and no name, just the rule (it separates the folder
         from whatever follows, including when the rotating list wraps).

     The whole row is indented by its nesting depth (see AudioFileAdapter), so a
     sub-folder's line starts where its parent's name does. The rule is the only
     full-width element, so a closing row reads as a plain line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folder_delimiter_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/folder_delimiter_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="18dp">

    <ImageView
        android:id="@+id/folder_delimiter_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder"
        android:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/folder_delimiter_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxWidth="240dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@color/divider"
        android:importantForAccessibility="no" />
</LinearLayout>
