<?xml version="1.0" encoding="utf-8"?>
<!-- Inline settings page (third swipeable page). Plain framework widgets keep
     this cheap and avoid a PreferenceFragment dependency.
     Order matters: rescan first, then the folder card (access + quick picks). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="@dimen/screen_pad"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="12dp">

        <!-- 1. Library / rescan -->
        <LinearLayout style="@style/SettingCard">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_library" />

            <TextView
                android:id="@+id/settings_library_info"
                style="@style/SettingSummary" />

            <Button
                android:id="@+id/settings_rescan"
                style="@style/SettingActionButton"
                android:text="@string/rescan" />
        </LinearLayout>

        <!-- 2. Audiobook folder: access first, then quick picks, then picker -->
        <LinearLayout
            android:id="@+id/settings_root_card"
            style="@style/SettingCard">

            <LinearLayout
                android:id="@+id/settings_access_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingTitle"
                    android:text="@string/settings_access" />

                <TextView
                    android:id="@+id/settings_access_status"
                    style="@style/SettingValue" />

                <TextView
                    android:id="@+id/settings_access_hint"
                    style="@style/SettingSummary" />

                <Button
                    android:id="@+id/settings_grant"
                    style="@style/SettingActionButton"
                    android:text="@string/grant_access" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/divider" />
            </LinearLayout>

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_root" />

            <TextView
                style="@style/SettingSummary"
                android:text="@string/settings_root_hint" />

            <TextView
                android:id="@+id/settings_root_path"
                style="@style/SettingValue"
                android:text="…" />

            <!-- Quick picks: the two standard places books are kept, plus the
                 SD card root when a removable volume is mounted. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settings_quick_music"
                    style="@style/QuickFolderButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/quick_music" />

                <Space
                    android:layout_width="@dimen/gap_small"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/settings_quick_books"
                    style="@style/QuickFolderButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/quick_books" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settings_quick_downloads"
                    style="@style/QuickFolderButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/quick_downloads" />

                <Space
                    android:id="@+id/settings_sd_space"
                    android:layout_width="@dimen/gap_small"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/settings_quick_sd"
                    style="@style/QuickFolderButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/quick_sd" />
            </LinearLayout>

            <Button
                android:id="@+id/settings_choose_folder"
                style="@style/SettingActionButton"
                android:text="@string/choose_folder" />

            <TextView
                android:id="@+id/settings_history_label"
                style="@style/SettingSummary"
                android:layout_marginTop="14dp"
                android:text="@string/previous_folders"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/settings_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 3. Seek step used by the -N / +N buttons -->
        <LinearLayout style="@style/SettingCard">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_seek" />

            <TextView
                android:id="@+id/settings_seek_value"
                style="@style/SettingValue"
                android:textSize="20sp" />

            <SeekBar
                android:id="@+id/settings_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seek_height"
                android:layout_marginTop="6dp"
                android:max="59"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:progressDrawable="@drawable/seek_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/PlayerTime"
                    android:text="1 s" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/PlayerTime"
                    android:text="60 s" />
            </LinearLayout>

            <TextView
                style="@style/SettingSummary"
                android:layout_marginTop="6dp"
                android:text="@string/settings_seek_hint" />
        </LinearLayout>

        <!-- 4. Toggles -->
        <LinearLayout style="@style/SettingCard">

            <LinearLayout
                android:id="@+id/settings_delete_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="@string/settings_delete_no_confirm" />

                    <TextView
                        style="@style/SettingSummary"
                        android:text="@string/settings_delete_no_confirm_hint" />
                </LinearLayout>

                <Switch
                    android:id="@+id/settings_delete_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/settings_keep_awake_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="@string/settings_keep_awake" />

                    <TextView
                        style="@style/SettingSummary"
                        android:text="@string/settings_keep_awake_hint" />
                </LinearLayout>

                <Switch
                    android:id="@+id/settings_keep_awake_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Playback positions -->
        <LinearLayout style="@style/SettingCard">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_positions" />

            <TextView
                style="@style/SettingSummary"
                android:text="@string/settings_positions_hint" />

            <Button
                android:id="@+id/settings_clear_positions"
                style="@style/SettingActionButton"
                android:text="@string/clear_positions" />
        </LinearLayout>

        <!-- 6. About -->
        <LinearLayout style="@style/SettingCard">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/settings_about_text"
                style="@style/SettingSummary"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/settings_version"
                style="@style/SettingSummary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
